<!DOCTYPE html>
<html>
<head>
    <title>My Personal Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { background: #000; color: white; display: flex; align-items: center; justify-content: center; height: 100vh; font-family: sans-serif; }
        input { padding: 15px; border-radius: 10px; border: none; width: 80%; }
        #app-content { display: none; }
    </style>
</head>
<body>
    <div id="setup">
        <h3>نظام الملفات الشخصي</h3>
        <input type="password" id="key" placeholder="أدخل رمز الوصول...">
        <button onclick="unlock()">دخول</button>
    </div>

    <div id="app-content">
        <!-- هنا سيظهر مشغل الأفلام لاحقاً -->
        <div id="movie-grid"></div>
    </div>

    <script>
        function unlock() {
            const key = document.getElementById('key').value;
            if(key === "1234") { // هذا هو رمزك السري
                document.getElementById('setup').style.display = 'none';
                document.getElementById('app-content').style.display = 'block';
                startApp();
            }
        }

        function startApp() {
            // هنا نضع روابط ستريمو المشفرة التي أعطيتك إياها سابقاً
            console.log("تم تفعيل التطبيق بنجاح!");
        }
    </script>
</body>
</html>
